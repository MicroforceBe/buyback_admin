//prisma/schema.prisma
 
generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
model DeviceUnit {
  id             String   @id @default(cuid())
  imei           String?  @unique
  imei2          String?
  serialNumber   String?
  udid           String?
 
  brand          String
  model          String?
  storage        String?
  color          String?

  cosmeticGrade  String?
  vatScheme      String?
 
  iosVersion     String?
  productType    String?
  modelNumber    String?
  partNumber     String?
  regionInfo     String?
  originCountry  String?
 
  batteryHealth                  Int?
  batteryCycles                  Int?
  batteryCurrentCharge           Int?
  batteryDesignCapacity          Int?
  batteryNominalChargeCapacity   Int?
  batteryVoltage                 Int?
  batteryTemperatureCelsius      Float?
 
  activationState       String?
  activationLockStatus  String?
  findMyStatus          String?
 
  mdmStatus             String?
  carrierLockStatus     String?
  simLockStatus         String?
  simStatus             String?
  carrierName           String?
  blacklistStatus       String?
 
  securityGrade         String?
  securityWarnings      Json?
  securityFailures      Json?
 
  rawDeviceData         Json?
 
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
 
  sessions              DiagnosticSession[]
}
 
 
model DiagnosticSession {
  id            String   @id @default(cuid())
  deviceUnitId  String
  status        String   @default("draft")
  finalGrade    String?
  finalScore    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
 
  deviceUnit    DeviceUnit @relation(fields: [deviceUnitId], references: [id])
  tests         DiagnosticTestResult[]
  appTests      DiagnosticAppTestResult[]
}
 
model DiagnosticTestResult {
  id          String   @id @default(cuid())
  sessionId   String
  testKey     String
  status      String
  value       Json?
  notes       String?
  createdAt   DateTime @default(now())
 
  session     DiagnosticSession @relation(fields: [sessionId], references: [id])
}
 
model DiagnosticAppTestResult {
  id        String   @id @default(cuid())
  sessionId String
  testKey   String
  status    String
  value     Json?
  notes     String?
  createdAt DateTime @default(now())
 
  session   DiagnosticSession @relation(fields: [sessionId], references: [id])
}

model ErpArticle {
  id                    String    @id @db.Uuid

  created_at            DateTime?
  updated_at            DateTime?

  sku                   String?
  ean                   String?
  title                 String?
  description           String?

  brand                 String?
  model                 String?
  capacity_gb           Int?
  color                 String?
  category              String?

  condition_grade       String?

  active                Boolean?

  erp_id                String?
  external_reference    String?

  price_cents           Int?
  compare_price_cents   Int?

  inventory_qty         Int?

  inventory_tracker     String?

  taxable               Boolean?
  vat_margin            Boolean?

  refurbished_product   Boolean?

  stock_gentbrugge      Int?
  stock_oudenaarde      Int?
  stock_antwerpen       Int?

  published             Boolean?
  published_scope       String?

  requires_shipping     Boolean?
  gift_card             Boolean?

  raw_erp_row           Json?

  core_assortment       Boolean?

  missing_from_erp      Boolean?
  missing_from_erp_at   DateTime?

  @@map("erp_articles")
}
